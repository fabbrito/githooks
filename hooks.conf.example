# hooks.conf - one repo's commit-message policy. Copy this to .githooks/,
# delete what you do not need, and keep it committed. Lanes live in
# lefthook.yml, not here.
#
# Format: INI-lite. `#` comments, blank lines ignored, `key = value`. Values
# split on whitespace. Every key below has the default shown, so a two-line
# config is valid.
#
# Unknown key, bad value, unknown schema, a [group] section: exit 2, along
# with anything else that stopped the grader judging your message. Never
# exit 1 - a broken config is not a rejected commit.

# The config format this file is written against. Absent means 1, which
# carried lanes and is refused: write 2.
schema = 2

# ------------------------------------------------------------ commit policy

# The `type` in `type(scope): subject`.
types = feat fix refactor chore style docs build perf

# Ceiling for the whole subject line, and for one body bullet.
subject_max = 72
body_cols   = 80

# How many bullets a body may carry. Keep the why, drop the rest.
bullet_max = 2

# The `scope` in `type(scope): subject`. Scope is optional in a message, but
# when present it must be on this list.
#
# scope_fixed: names that are not directories.
# scope_root:  a glob, once per line. Every directory it finds contributes its
#              basename. An unmatched glob is dropped, not an error. One glob
#              per line: whitespace in a pattern splits it.
scope_fixed = repo docs tools setup hooks make
# scope_root = dotfiles/common/*/
# scope_root = installers/*/

# Trailers are an allowlist, and it is exactly these two lists. A key in
# neither is rejected. Once a trailer appears, only trailers may follow.
#
# trailer_person:    Name <email>
# trailer_reference: one non-space token
trailer_person    = Co-Authored-By Signed-off-by Reviewed-by
trailer_reference = Refs Closes Fixes
